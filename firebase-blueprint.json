{
  "entities": {
    "BroadcastConfig": {
      "title": "BroadcastConfig",
      "description": "Configuration for smart board broadcast screen and active meal broadcast",
      "type": "object",
      "properties": {
        "activeMealId": { "type": "string" },
        "activeAgeTier": { "type": "string" },
        "autoRotateAgeTiers": { "type": "boolean" },
        "announcementTicker": { "type": "string" },
        "isVoiceActive": { "type": "boolean" },
        "cleanPlateCount": { "type": "number" },
        "lastUpdated": { "type": "number" }
      }
    },
    "Meal": {
      "title": "Meal",
      "description": "Scanned school meal with nutrition metrics and multi-tier age explanations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "detectedItems": { "type": "array" },
        "nutrition": { "type": "object" },
        "ageTierExplanations": { "type": "object" },
        "activeAgeTier": { "type": "string" },
        "sdgImpact": { "type": "object" },
        "timestamp": { "type": "number" },
        "canteenStaffNotes": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "timestamp"]
    },
    "WasteLog": {
      "title": "WasteLog",
      "description": "Daily food leftover log entry recorded by canteen staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "mealTitle": { "type": "string" },
        "ageTier": { "type": "string" },
        "totalPreparedKg": { "type": "number" },
        "totalLeftoverKg": { "type": "number" },
        "wastePercentage": { "type": "number" },
        "leftoverItems": { "type": "array" },
        "costLossEstimate": { "type": "number" },
        "co2ImpactKg": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "mealTitle"]
    },
    "WasteInsight": {
      "title": "WasteInsight",
      "description": "AI food waste insights report and SDG 12 impact metrics",
      "type": "object",
      "properties": {
        "wasteReductionScore": { "type": "number" },
        "averageWasteRate": { "type": "string" },
        "keyInsights": { "type": "array" },
        "sdg12ImpactMetrics": { "type": "object" },
        "smartBoardStudentChallenge": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "SchoolSetting": {
      "title": "SchoolSetting",
      "description": "School branding settings including name and emblem logo",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "schoolLogo": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    },
    "StaffAccount": {
      "title": "StaffAccount",
      "description": "Canteen staff login account and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "username"]
    },
    "ParentAccount": {
      "title": "ParentAccount",
      "description": "Parent account and student ward details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "grade": { "type": "string" },
        "walletBalance": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "username", "studentId"]
    },
    "LunchBooking": {
      "title": "LunchBooking",
      "description": "Student lunch booking with pickup PIN",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "parentName": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "grade": { "type": "string" },
        "mealId": { "type": "string" },
        "mealTitle": { "type": "string" },
        "mealPrice": { "type": "number" },
        "pickupPin": { "type": "string" },
        "bookingDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "parentId", "studentId", "mealId", "pickupPin"]
    },
    "BookingSettings": {
      "title": "BookingSettings",
      "description": "Lunch booking cutoff time configuration",
      "type": "object",
      "properties": {
        "cutoffTime": { "type": "string" },
        "isBookingAllowed": { "type": "boolean" },
        "lunchPrice": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Wallet transaction log for tracking topups and booking debits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "studentId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "parentId", "studentId", "type", "amount", "description", "timestamp"]
    },
    "ParentNotification": {
      "title": "ParentNotification",
      "description": "Notifications sent to parents regarding wallet activities and general canteen alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "parentId", "title", "message", "type", "isRead", "timestamp"]
    }
  },
  "firestore": {
    "/broadcast/{configId}": {
      "schema": { "$ref": "#/entities/BroadcastConfig" },
      "description": "Smart board broadcast screen configuration"
    },
    "/meals/{mealId}": {
      "schema": { "$ref": "#/entities/Meal" },
      "description": "Scanned meals and nutritional history records"
    },
    "/waste_logs/{logId}": {
      "schema": { "$ref": "#/entities/WasteLog" },
      "description": "Cafeteria food waste logs and audit entries"
    },
    "/waste_insights/{insightId}": {
      "schema": { "$ref": "#/entities/WasteInsight" },
      "description": "AI-generated waste reduction recommendations"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SchoolSetting" },
      "description": "School branding and configuration settings"
    },
    "/staff_accounts/{staffId}": {
      "schema": { "$ref": "#/entities/StaffAccount" },
      "description": "Canteen staff accounts for operator login"
    },
    "/parent_accounts/{parentId}": {
      "schema": { "$ref": "#/entities/ParentAccount" },
      "description": "Parent accounts and student wallets"
    },
    "/lunch_bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/LunchBooking" },
      "description": "Student lunch bookings and pickup PINs"
    },
    "/wallet_transactions/{txId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Log logs of wallet debits and credits"
    },
    "/parent_notifications/{notifId}": {
      "schema": { "$ref": "#/entities/ParentNotification" },
      "description": "Notifications sent to parents"
    }
  }
}
